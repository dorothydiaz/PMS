<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect /pages/ or /pages/index.php to main dashboard
    RewriteRule ^pages/?$ index.php [R=301,L]
    RewriteRule ^pages/index\.php$ index.php [R=301,L]

    # If requested URI exists as a real file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Allow accessing root scripts without .php extension (e.g. /login -> /login.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [L]

    # Allow accessing pages without .php extension (e.g. /pages/creatives-tracker -> /pages/creatives-tracker.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^pages/([a-zA-Z0-9_-]+)$ pages/$1.php [L]

    # Friendly root alias for pages (e.g. /creatives-tracker -> pages/creatives-tracker.php)
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)$ pages/$1.php [L]
</IfModule>
